Ejercicio 3 - Auditoría con Tests Unitarios e Integración Web (40 puntos)

Previo a la puesta en producción, EcoTech Solutions debe certificar la precisión del algoritmo de cálculo de huella de carbono industrial. Tras auditar su comportamiento mediante pruebas automatizadas, dicho algoritmo debe integrarse en la tubería de datos que alimenta la interfaz web administrativa de la empresa.

Punto A: Auditoría de Algoritmo de Emisiones ( unittest ): A partir de la función calcular_emisiones_carbono(consumo_kwh, factor_emision=0.4) (la cual eleva ValueError si el consumo es negativo), implementa la clase de prueba TestCalculoEmisiones(unittest.TestCase). Diseña los casos de prueba necesarios para validar tanto la exactitud numérica del cálculo ante valores nominales como la correcta elevación de la excepción ante consumos fuera de rango.

import unittest


def calcular_emisiones_carbono(consumo_kwh: float, factor_emision: float = 0.4) -> float:
    if consumo_kwh < 0:
        raise ValueError("El consumo en kWh no puede ser negativo.")
    return consumo_kwh * factor_emision


class TestCalculoEmisiones(unittest.TestCase):
    def test_calculo_valor_nominal_factor_por_defecto(self):
        resultado = calcular_emisiones_carbono(100.0)
        self.assertAlmostEqual(resultado, 40.0)

    def test_calculo_valor_nominal_factor_personalizado(self):
        resultado = calcular_emisiones_carbono(250.0, factor_emision=0.5)
        self.assertAlmostEqual(resultado, 125.0)

    def test_calculo_consumo_cero(self):
        resultado = calcular_emisiones_carbono(0.0)
        self.assertEqual(resultado, 0.0)

    def test_error_consumo_negativo(self):
        with self.assertRaises(ValueError):
            calcular_emisiones_carbono(-50.0)


if __name__ == "__main__":
    unittest.main()


Punto B: Procesamiento de Métricas y Renderizado Web: Incorpora la función calcular_emisiones_carbono en la función obtener_metricas_consumo(registros), procesando un historial de consumos por planta industrial para determinar el total global de emisiones y la planta de mayor consumo. Por último, diseña la función de vista en Django vista_panel_sustentabilidad(request) que invoque dicho procesamiento y proporcione el diccionario de contexto listo para ser renderizado en la plantilla sustentabilidad/panel.html.


from django.shortcuts import render


def calcular_emisiones_carbono(consumo_kwh: float, factor_emision: float = 0.4) -> float:
    if consumo_kwh < 0:
        raise ValueError("El consumo en kWh no puede ser negativo.")
    return consumo_kwh * factor_emision


def obtener_metricas_consumo(registros: list) -> dict:
    if not registros:
        return {"total_emisiones": 0.0, "planta_mayor_consumo": None, "detalle_plantas": []}

    total_emisiones = 0.0
    planta_mayor = None
    mayor_consumo = -1.0
    detalle_plantas = []

    for registro in registros:
        planta = registro["planta"]
        consumo = registro["consumo_kwh"]
        factor = registro.get("factor_emision", 0.4)

        emisiones = calcular_emisiones_carbono(consumo, factor)
        total_emisiones += emisiones

        if consumo > mayor_consumo:
            mayor_consumo = consumo
            planta_mayor = planta

        detalle_plantas.append({"planta": planta, "consumo_kwh": consumo, "emisiones_co2": round(emisiones, 2)})

    return {"total_emisiones": round(total_emisiones, 2), "planta_mayor_consumo": planta_mayor, "detalle_plantas": detalle_plantas}


def vista_panel_sustentabilidad(request):
    historial_consumos = [{"planta": "Planta Norte", "consumo_kwh": 15200.0}, {"planta": "Planta Sur", "consumo_kwh": 24800.0, "factor_emision": 0.45}, {"planta": "Planta Central", "consumo_kwh": 18500.0}]
    metricas = obtener_metricas_consumo(historial_consumos)
    contexto = {"titulo": "Panel de Sustentabilidad - EcoTech Solutions", "total_emisiones": metricas["total_emisiones"], "planta_mayor_consumo": metricas["planta_mayor_consumo"], "detalle_plantas": metricas["detalle_plantas"]}
    return render(request, "sustentabilidad/panel.html", contexto)

